{{ ansible_managed | comment }}
{ config, lib, pkgs, ... }:

{
  # apps.nix: the apps (containers, their ports), written by the apps playbooks
  imports = [
    ./hardware-configuration.nix
    ./network.nix
  ] ++ lib.optional (builtins.pathExists ./apps.nix) ./apps.nix;

  boot.loader.systemd-boot.enable = true;
  boot.loader.efi.canTouchEfiVariables = true;

  # Addresses in network.nix. The host is reachable by name: DNS, and mDNS
  # ({{ nixos_hostname }}.local).
  networking.hostName = "{{ nixos_hostname }}";
  services.avahi = {
    enable = true;
    nssmdns4 = true;
    openFirewall = true;
    publish = {
      enable = true;
      addresses = true;
    };
  };

  # SSH only; apps.nix opens its own ports
  networking.firewall.enable = true;

  time.timeZone = "{{ nixos_timezone }}";

  # Users are only the ones declared here
  users.mutableUsers = false;
  users.users.root.hashedPasswordFile = "/etc/nixos/secrets/root.hash";
  users.users.{{ nixos_admin_user }} = {
    isNormalUser = true;
    extraGroups = [ "wheel" ];
    openssh.authorizedKeys.keys = [ "{{ nixos_ssh_public_key | trim }}" ];
  };
  security.sudo.wheelNeedsPassword = false;

  # SSH keys only, and no root login: root is for the console
  services.openssh = {
    enable = true;
    settings = {
      PermitRootLogin = "no";
      PasswordAuthentication = false;
      KbdInteractiveAuthentication = false;
    };
  };

  # python3 for Ansible
  environment.systemPackages = with pkgs; [
    python3
{% for package in nixos_packages %}
    {{ package }}
{% endfor %}
  ];

  zramSwap.enable = true;

  nix.gc = {
    automatic = true;
    dates = "weekly";
    options = "--delete-older-than 30d";
  };

  system.stateVersion = "{{ nixos_state_version }}";
}
