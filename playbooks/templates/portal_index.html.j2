<!DOCTYPE html>
<!-- {{ ansible_managed }} -->
{# One card per nixos_services entry with an icon; the icons are drawn here so
   the page needs nothing from the internet #}
{% set icons = {
  'unifi': '<path d="M8 6v8a4 4 0 0 0 8 0V6"/><circle cx="16" cy="3.5" r="0.6" fill="currentColor"/>',
  'homeassistant': '<path d="M3 11.5 12 4l9 7.5"/><path d="M5.5 9.5V20h13V9.5"/><circle cx="12" cy="11" r="1.4"/><circle cx="9" cy="15" r="1.2"/><circle cx="15" cy="14" r="1.2"/><path d="M12 12.4V20M12 16l-3-1M12 15.5l3-1.5"/>',
  'frigate': '<rect x="3" y="6" width="13" height="8" rx="2"/><path d="m16 9 5-2v6l-5-2"/><path d="M7 14v3H4"/><circle cx="7.5" cy="10" r="1.5"/>',
  'sonarr': '<rect x="3" y="6" width="18" height="12" rx="2"/><path d="m9 3 3 3 3-3"/><path d="M8 21h8"/>',
  'radarr': '<rect x="4" y="4" width="16" height="16" rx="2"/><path d="M8 4v16M16 4v16M4 9h4M4 15h4M16 9h4M16 15h4"/>',
  'lidarr': '<path d="M9 18V5l11-2v13"/><circle cx="6" cy="18" r="3"/><circle cx="17" cy="16" r="3"/>',
  'prowlarr': '<circle cx="10.5" cy="10.5" r="6"/><path d="m15 15 5.5 5.5"/>',
  'transmission': '<path d="M12 3v12"/><path d="m7 10 5 5 5-5"/><path d="M4 17v2a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-2"/>',
  'jellyfin': '<path d="M12 3 3.5 19h17Z"/><path d="M12 9.5 8.2 16.5h7.6Z"/>',
  'immich': '<rect x="3" y="5" width="18" height="14" rx="2"/><circle cx="9" cy="10" r="1.6"/><path d="m21 16-5-5-8 8"/>',
  'nextcloud': '<path d="M7 18a4 4 0 0 1-.6-7.96A6 6 0 0 1 18 9a4.5 4.5 0 0 1-.5 9Z"/>',
} %}
{% set colors = {'unifi': '#1f6fff', 'homeassistant': '#18bcf2', 'frigate': '#3d8b5f',
                 'sonarr': '#2fa8d8', 'radarr': '#e0a200', 'lidarr': '#00a65b', 'prowlarr': '#e66001',
                 'transmission': '#b5121b', 'jellyfin': '#aa5cc3', 'immich': '#4250af', 'nextcloud': '#0082c9'} %}
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ inventory_hostname_short }}</title>
<style>
  :root { color-scheme: light dark; --bg: #f3f4f6; --card: #ffffff; --text: #111827; --muted: #6b7280;
          --track: #e5e7eb; --ok: #2563eb; --warn: #d97706; --crit: #dc2626; }
  @media (prefers-color-scheme: dark) {
    :root { --bg: #111318; --card: #1c1f26; --text: #e5e7eb; --muted: #9ca3af;
            --track: #2b303a; --ok: #60a5fa; --warn: #fbbf24; --crit: #f87171; }
  }
  * { box-sizing: border-box; }
  body { margin: 0; min-height: 100vh; display: flex; flex-direction: column; align-items: center;
         justify-content: center; gap: 2rem; padding: 2rem; background: var(--bg); color: var(--text);
         font-family: system-ui, -apple-system, "Segoe UI", sans-serif; }
  h1 { margin: 0; font-weight: 600; font-size: 1.5rem; }
  nav { display: grid; grid-template-columns: repeat(auto-fit, minmax(10rem, 1fr)); gap: 1.25rem;
        width: 100%; max-width: 40rem; }
  a { display: flex; flex-direction: column; align-items: center; gap: 0.75rem; padding: 1.5rem 1rem;
      border-radius: 1rem; background: var(--card); color: inherit; text-decoration: none;
      box-shadow: 0 1px 3px rgb(0 0 0 / 0.12); transition: transform 0.15s, box-shadow 0.15s; }
  a:hover, a:focus-visible { transform: translateY(-3px); box-shadow: 0 8px 20px rgb(0 0 0 / 0.18); outline: none; }
  .icon { display: grid; place-items: center; width: 4.5rem; height: 4.5rem; border-radius: 1.1rem; color: #fff; }
  svg { width: 2.75rem; height: 2.75rem; fill: none; stroke: currentColor; stroke-width: 1.6;
        stroke-linecap: round; stroke-linejoin: round; }
  .name { font-weight: 600; }
  .url { font-size: 0.75rem; color: var(--muted); }
  .stats { display: grid; gap: 0.9rem; width: 100%; max-width: 40rem; padding: 1.25rem 1.5rem;
           border-radius: 1rem; background: var(--card); box-shadow: 0 1px 3px rgb(0 0 0 / 0.12);
           transition: opacity 0.3s; }
  .stats[hidden] { display: none; }
  #meters { display: grid; gap: 0.9rem; }
  .stats.stale { opacity: 0.55; }
  .meter-head { display: flex; justify-content: space-between; gap: 1rem; font-size: 0.875rem; }
  .meter-name { font-weight: 600; }
  .meter-value, .stats-time { color: var(--muted); font-variant-numeric: tabular-nums; }
  .stats-time { font-size: 0.75rem; text-align: right; }
  .bar { height: 0.5rem; margin-top: 0.35rem; border-radius: 999px; background: var(--track); overflow: hidden; }
  .bar > span { display: block; height: 100%; border-radius: inherit; background: var(--ok); transition: width 0.4s; }
  .bar.warn > span { background: var(--warn); }
  .bar.crit > span { background: var(--crit); }
</style>
</head>
<body>
<h1>{{ inventory_hostname_short }}</h1>
<nav>
{% for service in nixos_services | selectattr('icon', 'defined') %}
  <a href="{{ service.scheme }}://{{ inventory_hostname }}:{{ service.port }}{{ service.path | default('') }}" data-port="{{ service.port }}">
    <span class="icon" style="background: {{ colors[service.icon] }}"><svg viewBox="0 0 24 24" aria-hidden="true">{{ icons[service.icon] }}</svg></span>
    <span class="name">{{ service.name }}</span>
    <span class="url">{{ service.scheme }} · {{ service.port }}</span>
  </a>
{% endfor %}
</nav>
<section class="stats" id="stats" aria-label="Resources" hidden>
  <div id="meters"></div>
  <div class="stats-time" id="stats-time"></div>
</section>
<script>
  // Same host as the portal, whatever name or address it was opened with
  for (const link of document.querySelectorAll("a[data-port]")) {
    const url = new URL(link.href);
    url.hostname = location.hostname;
    link.href = url.href;
  }

  // Resources, from the stats.json a host service writes every few seconds
  // (nixos role, nixos_stats_dir); hidden until it loads, dimmed when stale
  const stats = document.getElementById("stats");
  const meters = document.getElementById("meters");
  const statsTime = document.getElementById("stats-time");
  const gb = (bytes) => (bytes / 1e9).toFixed(bytes >= 1e11 ? 0 : 1) + " GB";

  function meter(name, percent, value) {
    const head = document.createElement("div");
    head.className = "meter-head";
    const label = document.createElement("span");
    label.className = "meter-name";
    label.textContent = name;
    const text = document.createElement("span");
    text.className = "meter-value";
    text.textContent = value;
    head.append(label, text);
    const bar = document.createElement("div");
    bar.className = "bar" + (percent >= 90 ? " crit" : percent >= 75 ? " warn" : "");
    bar.setAttribute("role", "meter");
    bar.setAttribute("aria-label", name);
    bar.setAttribute("aria-valuenow", Math.round(percent));
    bar.append(Object.assign(document.createElement("span"), { style: `width: ${Math.min(percent, 100)}%` }));
    const item = document.createElement("div");
    item.append(head, bar);
    return item;
  }

  async function refreshStats() {
    try {
      const response = await fetch("stats/stats.json", { cache: "no-store" });
      if (!response.ok) throw new Error(response.status);
      const s = await response.json();
      const memory = 100 * s.memory.used / s.memory.total;
      meters.replaceChildren(
        meter("CPU", s.cpu, `${Math.round(s.cpu)} % · load ${s.load.toFixed(2)} / ${s.cpus} CPUs`),
        meter("Memory", memory, `${gb(s.memory.used)} / ${gb(s.memory.total)} · ${Math.round(memory)} %`),
        ...s.disks.map((d) => meter(`Disk · ${d.name}`, 100 * d.used / d.size,
                                    `${gb(d.used)} / ${gb(d.size)} · ${Math.round(100 * d.used / d.size)} %`)));
      const age = Date.now() / 1000 - s.time;
      stats.classList.toggle("stale", age > 30);
      statsTime.textContent = (age > 30 ? "stale · " : "") + "updated " + new Date(s.time * 1000).toLocaleTimeString();
      stats.hidden = false;
    } catch {
      stats.classList.add("stale");
    }
  }
  refreshStats();
  setInterval(refreshStats, 5000);
</script>
</body>
</html>
